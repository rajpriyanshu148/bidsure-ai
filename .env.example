# BidSure AI - Environment Configuration Example

# Backend Core & Security
APP_NAME="BidSure AI"
APP_TAGLINE="AI-Powered Bid Compliance Verification & Decision Support Platform"
APP_VERSION="1.0.0"
DEBUG=True
JWT_SECRET="bidsure_ai_super_secret_jwt_key_sih2026_secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite for zero-config demo; PostgreSQL for production/docker)
DATABASE_URL="sqlite:///./bidsure.db"
# DATABASE_URL="postgresql://bidsure:bidsure_password_2026@localhost:5432/bidsure_db"

# AI & LLM Providers
# Options: "mock" (default, runs 100% offline without API key) or "openai"
LLM_PROVIDER="mock"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="all-MiniLM-L6-v2"

# Document Storage & OCR
STORAGE_PROVIDER="local"
STORAGE_DIR="./storage"
OCR_PROVIDER="pymupdf"

# CORS
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,*"

# Frontend Configuration
VITE_API_BASE_URL="http://localhost:8000/api/v1"
